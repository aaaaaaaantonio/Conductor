# Скопируйте в .env и заполните: cp .env.example .env
# Ключ шифрования cookie с токенами («Доступы»): любая длинная случайная строка,
# например: python3 -c "import secrets; print(secrets.token_hex(32))"
# Не меняйте после запуска: сохранённые токены у всех сбросятся.
CONDUCTOR_SECRET_KEY=

# Сюда же можно писать остальные переменные из README, например:
# JENKINS_BASE_URL=https://jenkins.company.ru
