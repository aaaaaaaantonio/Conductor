# Настройки Conductor. Скопируйте в .env и заполните:
#   cp .env.example .env && chmod 600 .env
# Запуск с ними: uv run --env-file .env uvicorn app.main:app ...
# Закомментированные строки показывают значения по умолчанию: раскомментируйте,
# чтобы изменить. Числовые оставляйте закомментированными, а не пустыми —
# пустое значение не число, и Conductor не стартует.

# --- Токены пользователей (cookie) -------------------------------------------

# Ключ шифрования cookie с токенами со страницы «Доступы». Любая длинная
# случайная строка, например:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Пусто — случайный ключ на каждый старт: токены теряются при перезапуске.
# Не меняйте после запуска: сохранённые токены у всех сбросятся.
CONDUCTOR_SECRET_KEY=

# true, когда Conductor работает по HTTPS.
# COOKIE_SECURE=false

# Адреса Conductor через запятую, если reverse proxy меняет Host
# (защита от CSRF). Пусто — Origin сверяется с Host запроса.
# CONDUCTOR_ALLOWED_ORIGINS=https://conductor.company.ru

# Сколько секунд без активности живут токены: без галочки «Запомнить» (12 ч)
# и с ней (30 дней).
# CREDS_SESSION_IDLE_TTL=43200
# CREDS_REMEMBER_IDLE_TTL=2592000
# Как часто (сек) cookie переиздаётся для продления.
# CREDS_REFRESH_AFTER=60
# Жёсткий предел с момента ввода токенов (10 лет).
# CREDS_MAX_LIFETIME=315360000

# --- Jenkins ------------------------------------------------------------------

JENKINS_BASE_URL=http://localhost:8080
# JENKINS_JOB_NAME_JAVA=java-tests
# JENKINS_JOB_NAME_PYTHON=python-tests

# --- Python VM-режим ----------------------------------------------------------

# Скрипт, который запускается локально (путь от текущей директории).
# PYTHON_TEST_RUNNER_PATH=./run-python-tests.sh

# --- Allure TestOps и Jira Zephyr ---------------------------------------------

# По этим адресам проверяются токены на странице «Доступы».
# Пусто — проверка пропускается.
ALLURE_BASE_URL=
JIRA_BASE_URL=

# --- База данных и логи -------------------------------------------------------

# По умолчанию — test_runner.db и job_logs/ в корне проекта.
# DATABASE_URL=sqlite:////opt/conductor/test_runner.db
# JOB_LOG_DIR=/opt/conductor/job_logs
# Завершённые запуски и их логи старше стольких дней удаляются.
# JOB_RETENTION_DAYS=5
# Сколько последних строк лога показывает панель.
# LOG_TAIL_LINES=200
# Строка длиннее показывается в браузере последними этим числом символов.
# LOG_LINE_MAX_CHARS=5000
